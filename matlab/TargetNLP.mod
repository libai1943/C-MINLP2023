# Targeted NLP (14): hard Euler/geometry equations and fixed local corridors.
param N integer >= 3;
param lw; param r2p; param f2p;
param vmax; param vmin; param amax; param wmax;
param beta; param w1; param w2;
param rx{1..N}; param ry{1..N}; param rt{1..N};
param direction{1..N}; param phimax{1..N};
param rear{1..N,1..4}; param front{1..N,1..4};
var tf >= 0.1;
var h = tf/(N-1);
var x{i in 1..N} >= rx[i]-beta, <= rx[i]+beta;
var y{i in 1..N} >= ry[i]-beta, <= ry[i]+beta;
var theta{1..N};
var v{i in 1..N} >= (if direction[i]>0 then 0 else vmin), <= (if direction[i]>0 then vmax else 0);
var a{1..N} >= -amax, <= amax;
var phy{i in 1..N} >= -phimax[i], <= phimax[i];
var w{1..N} >= -wmax, <= wmax;
var xr{i in 1..N} >= rear[i,1], <= rear[i,2];
var yr{i in 1..N} >= rear[i,3], <= rear[i,4];
var xf{i in 1..N} >= front[i,1], <= front[i,2];
var yf{i in 1..N} >= front[i,3], <= front[i,4];
minimize objective: w1*tf+w2*sum{i in 1..N}(a[i]^2+v[i]^2*w[i]^2);
subject to dyn_x{i in 1..N-1}: x[i+1]-x[i]=h*v[i]*cos(theta[i]);
subject to dyn_y{i in 1..N-1}: y[i+1]-y[i]=h*v[i]*sin(theta[i]);
subject to dyn_theta{i in 1..N-1}: theta[i+1]-theta[i]=h*v[i]*tan(phy[i])/lw;
subject to dyn_v{i in 1..N-1}: v[i+1]-v[i]=h*a[i];
subject to dyn_phy{i in 1..N-1}: phy[i+1]-phy[i]=h*w[i];
subject to geo_xr{i in 1..N}: xr[i]=x[i]+r2p*cos(theta[i]);
subject to geo_yr{i in 1..N}: yr[i]=y[i]+r2p*sin(theta[i]);
subject to geo_xf{i in 1..N}: xf[i]=x[i]+f2p*cos(theta[i]);
subject to geo_yf{i in 1..N}: yf[i]=y[i]+f2p*sin(theta[i]);
subject to endpoint_x{i in {1,N}}: x[i]=rx[i];
subject to endpoint_y{i in {1,N}}: y[i]=ry[i];
subject to endpoint_theta{i in {1,N}}: theta[i]=rt[i];
subject to endpoint_v{i in {1,N}}: v[i]=0;
subject to endpoint_a{i in {1,N}}: a[i]=0;
subject to endpoint_phy{i in {1,N}}: phy[i]=0;
subject to endpoint_w{i in {1,N}}: w[i]=0;
