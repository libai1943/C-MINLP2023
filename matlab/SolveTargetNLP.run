reset;
model TargetNLP.mod;
data AmplInputs/TargetData.dat;
include AmplInputs/InitialGuess.run;
option solver ipopt;
solve;
printf "%d\n", solve_result_num > "AmplResults/solve_result_num.txt";
close "AmplResults/solve_result_num.txt";
if solve_result_num >= 0 and solve_result_num < 100 then {
    printf {i in 1..N} "%.17g\n", x[i] > "AmplResults/x.txt";
    close "AmplResults/x.txt";
    printf {i in 1..N} "%.17g\n", y[i] > "AmplResults/y.txt";
    close "AmplResults/y.txt";
    printf {i in 1..N} "%.17g\n", theta[i] > "AmplResults/theta.txt";
    close "AmplResults/theta.txt";
    printf {i in 1..N} "%.17g\n", v[i] > "AmplResults/v.txt";
    close "AmplResults/v.txt";
    printf {i in 1..N} "%.17g\n", a[i] > "AmplResults/a.txt";
    close "AmplResults/a.txt";
    printf {i in 1..N} "%.17g\n", phy[i] > "AmplResults/phy.txt";
    close "AmplResults/phy.txt";
    printf {i in 1..N} "%.17g\n", w[i] > "AmplResults/w.txt";
    close "AmplResults/w.txt";
    printf {i in 1..N} "%.17g\n", xr[i] > "AmplResults/xr.txt";
    close "AmplResults/xr.txt";
    printf {i in 1..N} "%.17g\n", yr[i] > "AmplResults/yr.txt";
    close "AmplResults/yr.txt";
    printf {i in 1..N} "%.17g\n", xf[i] > "AmplResults/xf.txt";
    close "AmplResults/xf.txt";
    printf {i in 1..N} "%.17g\n", yf[i] > "AmplResults/yf.txt";
    close "AmplResults/yf.txt";
    printf "%.17g\n", tf > "AmplResults/tf.txt";
    close "AmplResults/tf.txt";
    printf "%.17g\n", objective > "AmplResults/objective.txt";
    close "AmplResults/objective.txt";
}
